{
  "expo": {
    "name": "quickfit4u-vp",
    "slug": "quickfit4u-vp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickfit4u.app",
      "infoPlist": {
        "NSCameraUsageDescription": "QuickFit4u uses your camera to scan QR codes for gym check-in."
      }
    },
    "android": {
      "package": "com.quickfit4u.app",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "QuickFit4u uses your camera to scan QR codes for gym check-in.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    }
  },
  "name": "quickfit4u-vp",
  "version": "1.0.0",
  "scripts": {},
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.10",
    "expo-constants": "~57.0.9",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.7",
    "expo-location": "~57.0.7",
    "expo-notifications": "~57.0.8",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-signature-canvas": "^5.1.0",
    "react-native-svg": "15.15.4",
    "react-native-vision-camera": "^4.7.3",
    "react-native-webview": "13.16.1"
  }
}
