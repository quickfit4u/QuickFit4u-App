{
  "expo": {
    "name": "quickfit4u-vp",
    "slug": "quickfit4u-vp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.quickfit4u.app",
      "infoPlist": {
        "NSCameraUsageDescription": "QuickFit4u uses your camera to scan QR codes for gym check-in."
      }
    },
    "android": {
      "package": "com.quickfit4u.app",
      "versionCode": 2,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "QuickFit4u uses your camera to scan QR codes for gym check-in.",
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0238b8f9-eb71-430c-9f47-02fa3ba9ff83"
      }
    },
    "owner": "vishakhapatnams-team"
  }
}
